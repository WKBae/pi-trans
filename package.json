{
  "name": "@wkbae/pi-trans",
  "version": "0.1.0",
  "description": "Write and read in your own language while the agent works in English: prompts go out translated, replies come back with a translation, code untouched.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "translate",
    "cc-trans"
  ],
  "repository": "github:WKBae/pi-trans",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@earendil-works/pi-tui": "^1.5.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
